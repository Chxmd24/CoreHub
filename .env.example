# ==========================================
# CoreHub Environment Variables Template
# ==========================================
# To configure your local environment:
# 1. Copy this file to .env (which is ignored by Git)
# 2. Update with your local database credentials

# Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=corehub_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Server Port
SERVER_PORT=8080

# JWT Security Configuration
# JWT_SECRET: REQUIRED. Must be a valid Base64-encoded string providing at least 32 cryptographically random bytes (256 bits) for HS256.
# The application will fail startup if this variable is missing, malformed Base64, or decodes to fewer than 32 bytes.
# Format: Base64-encoded string (minimum 44 characters for 32 bytes).
# Generate securely in PowerShell:
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $bytes = New-Object byte[] 32
#   $rng.GetBytes($bytes)
#   $env:JWT_SECRET = [Convert]::ToBase64String($bytes)
#   $rng.Dispose()
#   Remove-Variable rng, bytes
JWT_SECRET=REPLACE_WITH_YOUR_BASE64_ENCODED_SECRET_KEY_MIN_32_BYTES
JWT_EXPIRATION_MS=3600000

# Reservation Workflow Configuration
RESERVATION_EXPIRY_HOURS=24
RESERVATION_EXPIRY_CHECK_INTERVAL_MS=60000
