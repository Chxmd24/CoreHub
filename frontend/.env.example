# ==========================================
# CoreHub Frontend Environment Configuration
# ==========================================

# Base URL for the CoreHub Spring Boot backend API.
# In local development:
#   - Leave empty to automatically use Vite's development proxy (proxies /api to http://localhost:8080)
#   - Or set explicitly to http://localhost:8080
# In production (e.g., Vercel):
#   - Set to your deployed Railway backend URL (e.g. https://corehub-production.up.railway.app)
VITE_API_BASE_URL=http://localhost:8080
